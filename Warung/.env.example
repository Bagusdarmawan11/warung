# === Supabase ===
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi....
# Service role key - dipakai script import data lama, DAN oleh cron laporan
# WhatsApp harian (lihat bagian "Laporan WhatsApp Otomatis" di README). Kalau
# tidak pakai fitur laporan WhatsApp, boleh tidak diisi di Vercel (cukup ada
# di lokal buat script import). Kalau pakai, WAJIB diisi juga di Vercel -
# jangan pernah taruh di kode client / commit ke git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi....

# === URL Website (WAJIB untuk fitur undang user via email) ===
# Isi dengan URL production website kamu di Vercel
# Tanpa slash di akhir. Contoh: https://warung-rho.vercel.app
# === Nama Warung (opsional, tampil di header & laporan WhatsApp) ===
NEXT_PUBLIC_NAMA_WARUNG=Warung Saya

# === AI Insight (opsional) ===
# Kalau diisi, halaman Beranda akan menampilkan ringkasan & rekomendasi berbahasa natural dari Gemini.
# Kalau dikosongkan, halaman Beranda tetap jalan normal memakai analisis statistik biasa (tanpa narasi AI).
# Dapatkan API key GRATIS di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Laporan WhatsApp Otomatis (opsional) ===
# Kalau diisi semua, sistem otomatis kirim laporan harian (tiap hari), mingguan
# (tiap Senin), dan bulanan (tiap tanggal 1) lewat WhatsApp ke nomor kamu,
# sekitar jam 00:00 WIB. Kalau salah satu kosong, fitur ini otomatis nonaktif
# (tidak mengganggu fitur lain). Lihat bagian "Laporan WhatsApp Otomatis" di
# README untuk cara setup lengkap.
FONNTE_TOKEN=
FONNTE_TARGET=6281234567890
# String rahasia bebas (boleh generate sendiri, misal lewat https://generate-secret.vercel.app/32)
# - dipakai untuk memastikan cuma Vercel Cron yang boleh memicu endpoint laporan.
CRON_SECRET=

# === URL Website (WAJIB untuk undang user via email) ===
# Tanpa slash di akhir. Contoh: https://warung-rho.vercel.app
NEXT_PUBLIC_BASE_URL=https://warung-rho.vercel.app
